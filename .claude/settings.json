{
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "enabledMcpjsonServers": ["playwright"],
  "permissions": {
    "deny": [
      "Bash(git reset:*)",
      "Bash(git checkout --:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git restore:*)",
      "Bash(git checkout .)",
      "Bash(git checkout * -- *)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push --mirror*)",
      "Bash(git push --all*)",
      "Bash(supabase db reset --linked*)",
      "Bash(supabase db push*)",
      "Bash(vercel deploy*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -m:*)",
      "Bash(git branch --delete:*)",
      "Bash(npm install:*)",
      "Bash(npm.cmd install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm.cmd uninstall:*)"
    ],
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm.cmd run:*)",
      "Bash(npm test:*)",
      "Bash(npm.cmd test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(node scripts/gate.mjs:*)",
      "Bash(node scripts/overseer.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch --list:*)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git branch --show-current)",
      "mcp__playwright"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-file.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-haiku-5-5": {
      "effortLevel": "low"
    }
  }
}
